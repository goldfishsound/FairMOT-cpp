import torch
import coremltools as ct


def main():

    # Load the model
    traced_model = torch.jit.load("weights/fairmot_dla34_jit.pth")
    # traced_model.to("cpu")
    traced_model.eval()

    # Define input shape/type for conversion
    example_input = torch.rand(1, 3, 480, 864)

    # Convert to Core ML program using the Unified Conversion API.
    model_from_trace = ct.convert(
        traced_model,
        inputs=[ct.TensorType(shape=example_input.shape)],
    )


    print("Saving model to")

    model_from_trace.save("weights/model_traced.mlpackage")


if __name__ == "__main__":
    main()
